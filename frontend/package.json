    "expo-linking": "~55.0.13",
    "expo-modules-core": "^55.0.22",
    "expo-router": "^55.0.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
